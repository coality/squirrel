# file-deploy.conf — one configuration, one source, one destination.
#
# Syntax: NAME = value, one per line. Quotes are optional and only needed to
# protect leading/trailing spaces; everything after an unquoted # is a comment.
# Lists (INPUT_DIR_NAME, EXCLUDE_DIR_PATTERNS) are comma-separated.
# Unknown names and bad values are refused -- run --check to see them all.
#
# Copy this file and adjust. To handle another source/destination pair, write
# another configuration file and give it its own run:
#
#   file-deploy.sh --config /etc/file-deploy/compta-prod.conf
#   file-deploy.sh --config /etc/file-deploy/rh-homol.conf
#
# Check a configuration before using it:  file-deploy.sh --config X.conf --check
#
# WARNING: this tool DELETES from the source. Rehearse with --dry-run first.

# ===========================================================================
# Identity — read this first
# ===========================================================================
# Names this configuration in the logs and in the CSV report, AND is what the
# state, log and lock paths are derived from. That is what makes it impossible
# for two configurations to trample each other's state.
#
# Defaults to this file's base name (compta-prod.conf -> "compta-prod").
# Allowed characters: letters, digits, . _ -
INSTANCE_ID="compta-prod"

# ===========================================================================
# What to drain, and where to
# ===========================================================================
# SOURCE_DIR is a ROOT: file-deploy looks under it for directories named
# INPUT_DIR_NAME, at any depth, and drains those. DEPLOY_DIR receives the same
# tree, relative paths included:
#
#   SOURCE_DIR/projA/input/facture.xml  ->  DEPLOY_DIR/projA/input/facture.xml
#   SOURCE_DIR/projB/input/sub/bl.txt   ->  DEPLOY_DIR/projB/input/sub/bl.txt
#
# Both are required. Absolute paths.
SOURCE_DIR="/mnt/nas/compta"
DEPLOY_DIR="/mnt/nas/deploy/compta"

# EXACT name(s) of the directories to drain under SOURCE_DIR. Several allowed,
# separated by COMMAS only, e.g. "input,Input,input_" — 'input' alone does NOT
# match 'Input'. Names are matched literally (no globs: "input*" matches a
# directory really called "input*", not "input_old") and MAY CONTAIN SPACES,
# e.g. "Input Files,input" — which is why the comma is the only separator.
#
# Files taken: those directly inside each input directory, and those directly
# inside its direct sub-directories. Nothing deeper.
INPUT_DIR_NAME="input"

# ===========================================================================
# Safety
# ===========================================================================
# A file is only taken once it has been untouched for this long. 0 is safe ONLY
# if you can prove every producer publishes atomically (writes elsewhere, then
# renames into place). Windows Explorer copies, SMB clients, rsync without
# --partial-dir, scanners and ERP exports usually do NOT. Size it as the longest
# plausible write plus clock skew; it costs latency, not throughput. The
# size+mtime re-check performed immediately before the move is the backstop,
# this is the tuning knob.
MIN_STABLE_AGE=10

# Simulate: log a WOULD_MOVE line per file with the deployment verdict and the
# archive path, without writing or deleting anything. --dry-run does the same
# from the command line and is preferred: it cannot be left switched on by
# accident. Whenever it is active the run logs DRY_RUN_ACTIVE at WARN.
DRY_RUN = no

# Sentinel file at the root of DEPLOY_DIR. It is what tells a mounted deployment
# share apart from a bare, unmounted mount point: without it, an unmounted
# destination would be filled on the local disk, every file would then be moved
# out of the source because of it, and on remount the tree would be empty and
# the sources gone. The script creates the marker itself (on the first run, or
# by adopting a pre-existing tree); a missing marker on a configuration that has
# deployed here before is refused with DEPLOY_UNAVAILABLE and exit 4.
# "" disables the check -- strongly discouraged on a mounted share.
DEPLOY_MARKER=".file-deploy-root"

# Name of the archive directory created next to each file taken out of the
# source: <pickup dir>/<name>/<file>. Matched EXACTLY (case-sensitive, no globs)
# and pruned from every walk, so file-deploy never re-deploys its own output --
# which also means a directory of this name is never deployed. Rename it here if
# that collides with a real directory in your tree. "" disables the local
# archive entirely: moved files then exist only in the deployment tree.
LOCAL_ARCHIVE_DIR="archive"

# Content hash, used to verify every copy before it is published and to name
# archive entries. Any algorithm hashlib knows: sha256, sha1, md5, blake2b...
HASH_ALGO = sha256

# Carry the source file's mode and timestamps over to the deployed copy.
# It is a nicety, never part of the transaction: the content is always copied and
# hash-verified, and a share that refuses chmod/utime (CIFS/SMB routinely does,
# with "Operation not permitted") gets one METADATA_NOT_PRESERVED warning per run
# and the deployment goes ahead. Set it to no on such a share to stop trying and
# silence the warning.
PRESERVE_METADATA = yes

# ===========================================================================
# What to do when the destination already holds a DIFFERENT file
# ===========================================================================
# Identical content is never a conflict: nothing is rewritten, and the source
# file is archived and drained either way. This setting only decides what
# happens when DEPLOY_DIR/<same relative path> exists with a different hash.
#
#   overwrite  Replace the deployed file. The version it replaced is NOT lost:
#              the incoming file is archived locally, and the audit line records
#              the digest that was replaced (prev_hash=). Right when the source
#              is authoritative.
#
#   version    Deploy alongside instead of replacing: the existing file is kept
#              and the incoming one lands next to it as
#              <name>_<YYYYMMDD_HHMMSS><ext>, stamped from the SOURCE mtime so a
#              retry always resolves to the same name. Nothing is ever lost on
#              either side, at the cost of a deployment tree that accumulates.
#
#   skip       Leave the deployment tree completely alone. The incoming file is
#              still archived locally and drained from the pickup directory, so
#              nothing is lost and nothing piles up -- but the deployed file
#              stays stale. Logged at WARN (DEPLOY_SKIPPED) on every collision.
#              Use when the destination is authoritative.
#
#   retry      Leave BOTH sides alone and keep the source file where it is, to
#              be retried every cycle until the collision clears by itself --
#              typically when a downstream consumer takes the deployed file
#              away. WARN once per run (DEPLOY_RETRY), exit 0. Note the file is
#              re-hashed on every cycle until it resolves.
#
#   fail       Refuse. The source file is KEPT, nothing is archived, an ERROR is
#              logged (DEPLOY_CONFLICT) and the run exits 4. Use when a
#              collision means something upstream is wrong and a human must look.
#
# Examples
#   ON_CONFLICT="overwrite"   # source wins; history kept in the local archive
#   ON_CONFLICT="version"     # keep both sides, never clobber anything
#   ON_CONFLICT="skip"        # destination wins; drain the source anyway
#   ON_CONFLICT="retry"       # wait for the destination to clear, keep the file
#   ON_CONFLICT="fail"        # stop and alert; keep the source file untouched
#
# An unrecognised value stops the run (exit 1) rather than guessing. Whatever
# the policy, --dry-run reports the exact verdict it would apply, per file, in
# the WOULD_MOVE line's deploy= field.
ON_CONFLICT="overwrite"

# ===========================================================================
# Scanning
# ===========================================================================
# Seconds between scan passes. Small is fine: an idle pass only stats the input
# directories, it does not list them.
SCAN_INTERVAL=2

# Continuous mode: the script loops for RUN_DURATION seconds, scanning every
# SCAN_INTERVAL, so there is no per-minute gap. Keep it high; a cron entry every
# minute just restarts it if it died, and the flock guarantees a single instance
# per INSTANCE_ID. See README "Run with cron".
RUN_DURATION=86400

# Locating the input directories is a full-tree walk, so it is cached and only
# redone every DISCOVERY_INTERVAL seconds (or on --rediscover, or when the
# settings that shape the walk change). Lower it if new input directories appear
# often.
DISCOVERY_INTERVAL=1800
# Cap the discovery walk depth (0 = unlimited); set it if the input directories
# sit at a known depth, e.g. 6.
DISCOVERY_MAXDEPTH=0

# Skip a directory whose mtime has not changed since the last pass.
USE_DIR_MTIME_SKIP = yes
# The skip above trusts the share to bump a directory's mtime when a file is
# added. Every DEEP_SCAN_INTERVAL seconds one pass ignores the skip and lists
# everything, which recovers a share that does not. It is cheap: a drained
# pickup directory is the steady state. 0 = off, and a share with unreliable
# directory mtimes then hides new files indefinitely.
DEEP_SCAN_INTERVAL=300

# Directory-name patterns (case-insensitive globs) to ignore anywhere in the
# tree. A matching directory is skipped and never descended into. Useful for a
# producer's staging directories. Bash array; empty = off.
EXCLUDE_DIR_PATTERNS =
# EXCLUDE_DIR_PATTERNS = "~*, *.tmp, *en_cours*"

# ===========================================================================
# Report, for BI tools
# ===========================================================================
# Same shape as file-dispatch's, deliberately: the two reports are meant to be
# read side by side, with the same first eight columns and the same vocabulary.
#
#   <REPORT_DIR>/report.state    the authority. Never open it.
#   <REPORT_DIR>/report.csv      published from the state -- this is what you read
#
# Two files on purpose. A spreadsheet holding report.csv open on a share blocks
# the rename that publishes it, so publishing is allowed to fail while the state
# is not: nothing is lost, and the next run republishes by itself.
#
# ONE ROW PER FILE, not per success. The row opens the first time the file is
# seen and closes when it is delivered, so a file that is stuck -- unreadable,
# blocked by a conflict, still being written -- is visible with its status and
# its retry count instead of being absent from the dataset.
#
# In Power BI: Get Data > Folder > <REPORT_DIR> > Combine & Transform, then
# filter on *.csv so report.state is left alone.
#
# Nothing is written during a rehearsal: --dry-run stays inert.
#
# Columns -- the first eight are file-dispatch's, unchanged
#   filename          base name
#   first_seen        when the file was first seen (with milliseconds: it is
#                     half of the row's key)
#   file_date         the file's own mtime
#   destination       the directory it was deployed into; empty when skipped
#   moved_at          when it was delivered; empty while it is not
#   status            success | pending | failed  -- what a dashboard filters on
#   retries           runs it took before succeeding
#   reason            why it is not done, when it is not
# ...then what only a move can say
#   relpath           path relative to the roots, identical on both sides: the
#                     natural key to join source and destination
#   instance          the INSTANCE_ID that produced the row
#   run_id, host      which run, on which machine
#   outcome           the deployment verdict: DEPLOYED | DEPLOYED_OVERWRITE
#                     | DEPLOYED_VERSION | DEPLOYED_IDENTICAL | DEPLOY_SKIPPED,
#                     or the event that blocked it. Refines `status`.
#   source_path       absolute path it was picked up from
#   archive_path      absolute path of the local archive copy -- THIS is what you
#                     use to retrieve the file afterwards
#   pickup_dir        the directory it came from -- group by supplier/site
#   size_bytes, hash  size and full content digest (HASH_ALGO)
#   prev_hash         digest that was already at the destination on a collision.
#                     Chains to an earlier row's hash, so a self-join rebuilds a
#                     path's whole history.
#   source_created    real birth time, EMPTY unless the platform exposes one to
#                     Python (macOS/BSD do; Linux does not). Build on file_date.
#   age_at_pickup_s   how long the file waited before being taken -- a latency
#                     KPI: a rising curve means SCAN_INTERVAL or MIN_STABLE_AGE
#                     is too high, or the producer writes slowly.
# ...then what happens AFTER delivery. A deployment tree is a letterbox, not a
# resting place: another system comes and takes the files. We cannot see it
# work, but we can see the file leave, and each run looks at the deliveries
# still waiting.
#   target            the exact path delivered. Not destination + filename:
#                     ON_CONFLICT="version" renames, and probing the wrong path
#                     would answer about a file we never wrote.
#   still_present     yes | no -- is it still in the deployment tree? Empty when
#                     nothing was delivered (a skipped deploy), and empty on
#                     rows written before this existed: they carry no target and
#                     are left alone.
#   last_check        two regimes. While the file is there it ADVANCES every
#                     run -- "still there as of". The run that finds it gone
#                     FREEZES it on that instant, which turns it into the date
#                     the file was observed consumed. Nothing looks at that row
#                     again.
#   transit_seconds   moved_at -> last_check, the time it sat in the deployment
#                     tree. An UPPER BOUND by nature: it left at some point
#                     between the previous check and this one, so the resolution
#                     is the cron interval, not better.
#
# A file the downstream system never takes is checked for ever: no bound, no
# extra setting. Two consequences to accept: the "an idle run writes nothing"
# shortcut does not hold while a delivery is pending -- a touched row is a row
# to rewrite -- and each run costs one existence check per pending row, on the
# share. Cheap in the healthy case, where a row is pending for a run or two;
# but if the downstream system stops, every run rewrites the report.
#
# "" disables the report entirely.
REPORT_DIR = ""

# Field separator of the PUBLISHED copy. Power BI and Excel in a French locale
# often expect ";". The state always stays comma-separated so it can be read
# back whatever this says.
REPORT_DELIMITER = ","

# Split the published report into one file per period: none | daily | monthly.
# A row lives in exactly one file, so the whole folder read together is the
# report -- nothing to reconcile. Splitting also means a spreadsheet open on
# last month's file never collides with this month's writes.
REPORT_SPLIT = none

# Drop a row this long after it was delivered (or first seen, if it never was).
# 0 keeps everything for ever.
REPORT_KEEP_DAYS = 90

# ===========================================================================
# Logging
# ===========================================================================
LOG_LEVEL      = INFO       # DEBUG | INFO | WARN | ERROR
LOG_FORMAT     = text       # text (key=value) or json
LOG_CONSOLE    = auto       # auto (mirror to the terminal when interactive)
                            # | always | never
LOG_MAX_BYTES  = 10485760   # rotate a log past 10 MB (0 = never)
LOG_KEEP       = 7          # number of rotated files kept
AUDIT_LOG      = yes        # append-only trail of what moved
HEARTBEAT_INTERVAL = 60     # seconds between "still alive" summaries (0 = off)

# ===========================================================================
# Paths — optional
# ===========================================================================
# All three default to something derived from INSTANCE_ID, which is why two
# configurations cannot collide:
#
#   STATE_DIR  <script dir>/state/<INSTANCE_ID>
#   LOG_DIR    <script dir>/logs/<INSTANCE_ID>
#   LOCK_FILE  <script dir>/run-<INSTANCE_ID>.lock
#
# Override them only to put them elsewhere, and keep them distinct per
# configuration: a shared STATE_DIR is refused at startup (STATE_DIR_CONFLICT),
# but a shared LOCK_FILE would silently serialise two configurations instead.
# STATE_DIR="/var/lib/file-deploy/compta-prod"
# LOG_DIR="/var/log/file-deploy/compta-prod"
# LOCK_FILE="/run/file-deploy-compta-prod.lock"
