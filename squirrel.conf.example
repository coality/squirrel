# squirrel.conf — global defaults, sourced by squirrel.sh
# Copy this file to squirrel.conf and adjust. Values here are the defaults
# applied to a target whenever its column in targets.tsv is empty or "-".

# --- Defaults applied per target when the column is "-" ---
INPUT_DIR_NAME="input"          # EXACT name of the scanned directory
SCAN_INTERVAL=2                 # seconds between scan passes (small = better capture;
                                # idle passes only stat directories, so this stays cheap)

# --- Execution ---
# Continuous mode: the script loops for RUN_DURATION seconds, scanning every
# SCAN_INTERVAL, so there is no per-minute gap. Keep it high; a cron entry every
# minute just restarts it if it died, and the internal flock guarantees a single
# instance. See README "Run with cron".
RUN_DURATION=86400              # ~24h continuous loop, then it recycles (cron restarts it)
MIN_STABLE_AGE=0                # min file age (s) before archiving; keep 0 if files are written
                                # atomically (rename/mv into 'input'); raise it only for in-place writes
REQUIRE_MOUNT=true              # skip a target whose source is missing/unreadable (unmounted share)
HASH_CMD="sha256sum"            # content hash command
DRY_RUN=false                   # true = simulate, copy nothing
# TARGETS_FILE defaults to <script directory>/targets.tsv; set an absolute path to override:
# TARGETS_FILE="/opt/squirrel/targets.tsv"

# --- Discovery & I/O (minimise disk access) ---
DISCOVERY_INTERVAL=1800         # seconds between full-tree rediscoveries of input dirs
USE_DIR_MTIME_SKIP=true         # skip a directory whose mtime has not changed (flat drops)

# --- Logging ---
LOG_LEVEL="INFO"                # DEBUG | INFO | WARN | ERROR
LOG_FORMAT="text"               # text (key=value) | json (JSON lines)
LOG_ROTATE_MAX_BYTES=10485760   # rotate a log past 10 MB (0 = never)
LOG_ROTATE_KEEP=7               # number of rotated files kept
AUDIT_LOG=true                  # write a separate append-only audit log per target

# --- Paths (optional; derived from the script directory if unset) ---
# STATE_DIR="/opt/squirrel/state"
# LOG_DIR="/opt/squirrel/logs"
# LOCK_FILE="/opt/squirrel/run.lock"
