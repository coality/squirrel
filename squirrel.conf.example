# squirrel.conf — global defaults, sourced by squirrel.sh
# Copy this file to squirrel.conf and adjust. Values here are the defaults
# applied to a target whenever its column in targets.tsv is empty or "-".

# --- Defaults applied per target when the column is "-" ---
INPUT_DIR_NAME="input"          # EXACT name(s) of the scanned directory. Several exact,
                                # case-sensitive names allowed, separated by spaces or
                                # commas, e.g. "input Input input_" (no globs). 'input'
                                # alone does NOT match 'Input' — list each variant.
SCAN_INTERVAL=2                 # seconds between scan passes (small = better capture;
                                # idle passes only stat directories, so this stays cheap)

# --- Execution ---
# Continuous mode: the script loops for RUN_DURATION seconds, scanning every
# SCAN_INTERVAL, so there is no per-minute gap. Keep it high; a cron entry every
# minute just restarts it if it died, and the internal flock guarantees a single
# instance. See README "Run with cron".
RUN_DURATION=86400              # ~24h continuous loop, then it recycles (cron restarts it)
MIN_STABLE_AGE=0                # min file age (s) before archiving; keep 0 if files are written
                                # atomically (rename/mv into 'input'); raise it only for in-place writes
REQUIRE_MOUNT=true              # skip a target whose source is missing/unreadable (unmounted share)
HASH_CMD="sha256sum"            # content hash command
DRY_RUN=false                   # true = simulate, copy nothing
# TARGETS_FILE defaults to <script directory>/targets.tsv; set an absolute path to override:
# TARGETS_FILE="/opt/squirrel/targets.tsv"

# --- Discovery & I/O (minimise disk access) ---
DISCOVERY_INTERVAL=1800         # seconds between full-tree rediscoveries of input dirs
DISCOVERY_MAXDEPTH=0            # cap the discovery walk depth (0 = unlimited); set it if input dirs
                                # sit at a bounded depth to speed up discovery, e.g. 6
USE_DIR_MTIME_SKIP=true         # skip a directory whose mtime has not changed
# Directory-name patterns (case-insensitive globs) to ignore anywhere in the tree.
# A matching directory is skipped and never descended into. Bash array; empty = off.
EXCLUDE_DIR_PATTERNS=()
# EXCLUDE_DIR_PATTERNS=('*archived*' '*archive*' '*.bak')

# --- Extra directories: specific source -> specific destination rules ---
# Besides the automatic discovery of "input" directories (driven by targets.tsv),
# you can archive one or more SPECIFIC directories to a SPECIFIC destination, with
# no discovery at all. Each rule is one array element, TAB-separated (like
# targets.tsv, so paths may contain spaces):
#
#     label <TAB> source <TAB> destination <TAB> depth
#
#   - label        identity of the rule; its ledger and logs live under
#                  "<label>__extra" (state/<label>__extra.ledger.tsv,
#                  logs/<label>__extra/). Must be unique.
#   - source       the exact directory to archive (a fixed path; no "input" lookup).
#   - destination  where its content is mirrored: <source>/sub/f -> <destination>/sub/f.
#   - depth        0  = only files directly in <source>;
#                  N  = also N sub-levels deep (1 = like the input scanner);
#                  -1 = the whole subtree (aliases: unlimited, inf, all).
#                  Empty or "-" defaults to 1.
#
# The same engine applies: hash dedup, timestamped versioning, MIN_STABLE_AGE
# stability, EXCLUDE_DIR_PATTERNS, DRY_RUN, per-rule logging and audit trail.
# Bash array; empty = no extra directories. Tip: write real TABs, or use $'...\t...'.
EXTRA_DIRS=()
# EXTRA_DIRS=(
#   $'reports\t/mnt/nas/app/reports\t/mnt/nas/archive/reports\t2'
#   $'daily\t/mnt/nas/daily out\t/mnt/nas/archive/daily\t0'
#   $'everything\t/mnt/nas/app/exports\t/mnt/nas/archive/exports\tunlimited'
# )

# --- Logging ---
LOG_LEVEL="INFO"                # DEBUG | INFO | WARN | ERROR  (DEBUG = maximum detail)
LOG_FORMAT="text"               # text (key=value) | json (JSON lines)
LOG_ROTATE_MAX_BYTES=10485760   # rotate a log past 10 MB (0 = never)
LOG_ROTATE_KEEP=7               # number of rotated files kept
AUDIT_LOG=true                  # write a separate append-only audit log per target
LOG_CONSOLE="auto"              # mirror log lines to the terminal: auto (only when interactive) | always | never
HEARTBEAT_INTERVAL=60           # seconds between periodic "still alive" summaries in _run.log (0 = off)

# --- Paths (optional; derived from the script directory if unset) ---
# STATE_DIR="/opt/squirrel/state"
# LOG_DIR="/opt/squirrel/logs"
# LOCK_FILE="/opt/squirrel/run.lock"
