# targets.tsv — one line per (project, environment) to drain.
# WARNING: file-deploy MOVES files out of source_root. Rehearse with DRY_RUN=true.
# TAB-separated. Use "-" (or leave empty) to inherit the global default from
# file-deploy.conf. Lines starting with # and blank lines are ignored.
# Columns: project<TAB>env<TAB>source_root<TAB>deploy_root<TAB>input_dir_name<TAB>scan_interval<TAB>enabled
# Required: project, env, source_root, deploy_root (where files are DEPLOYED). Optional: input_dir_name, scan_interval, enabled (default true).
# input_dir_name may list several exact names, separated by COMMAS only, e.g. "input,Input,input_".
#   Names are matched literally (no globs) and may contain spaces ("Input Files,input"),
#   which is why the comma is the only separator.
# enabled must be true/false (yes/no, 1/0, on/off accepted); anything else logs
#   TARGET_BAD_ENABLED and skips the target.
# NOTE: fields are TAB-separated so that source_root / deploy_root may contain spaces.
#   Aligning the columns with spaces instead shifts every field after a value that
#   contains one — the script warns (TARGET_EXTRA_FIELDS) but tabs are the only safe form.
projectA	prod	/mnt/nas/projectA/prod	/mnt/nas/deploy/projectA/prod	input	10	true
projectA	homol	/mnt/nas/projectA/homol	/mnt/nas/deploy/projectA/homol	input	10	true
projectB	prod	/mnt/nas/projectB/prod	/mnt/nas/deploy/projectB/prod	-	-	true
projectB	homol	/mnt/nas/projectB/homol	/mnt/nas/deploy/projectB/homol	-	-	false
